OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-nano
# true: fake payments, no Stripe calls. false: Stripe test mode (needs a test secret key; no webhooks).
MOCK_PAYMENTS=true
# Switching an existing database from true to false: charges made in mock mode are refunded without calling
# Stripe, and real shoppers whose card was saved in mock mode must save it again (Join returns card_required).
# Only read when MOCK_PAYMENTS=false. Use a test-mode key (sk_test_...), never a live one.
STRIPE_SECRET_KEY=sk_test_...
# Stripe Checkout returns the shopper to {FRONTEND_URL}/payment/success.
FRONTEND_URL=http://localhost:3000
DATABASE_URL=sqlite:///./quorum.db
